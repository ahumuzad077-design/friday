import os
import json
import logging
import requests
import pandas as pd
import numpy as np
import ccxt
from dotenv import load_dotenv

load_dotenv()

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

class MarketBot:
    def __init__(self):
        self.exchange = ccxt.binance({
            'enableRateLimit': True,
        })
        logger.info("MarketBot initialized with CCXT.")

    def fetch_market_data(self, symbol="BTC/USDT", timeframe="1h", limit=100):
        """Fetch historical OHLCV data from exchange."""
        try:
            ohlcv = self.exchange.fetch_ohlcv(symbol, timeframe, limit=limit)
            df = pd.DataFrame(ohlcv, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
            df['timestamp'] = pd.to_datetime(df['timestamp'], unit='ms')
            return df
        except Exception as e:
            logger.error(f"Error fetching market data: {e}")
            return None

    def calculate_indicators(self, df):
        """Calculate basic technical indicators (SMA, Volatility)."""
        if df is None or df.empty:
            return df
        df['sma_20'] = df['close'].rolling(window=20).mean()
        df['volatility'] = df['close'].pct_change().rolling(window=20).std()
        return df

if __name__ == "__main__":
    bot = MarketBot()
    data = bot.fetch_market_data("BTC/USDT", "1h", 50)
    processed_data = bot.calculate_indicators(data)
    print("Market data and indicators loaded successfully.")
