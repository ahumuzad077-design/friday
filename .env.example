# F.R.I.D.A.Y. v2 environment template
# NEVER commit real credentials. Put secrets in Railway Variables.

APP_ENV=production
LIVE_MODE=false
PAYMENT_VERIFICATION_REQUIRED=true
MAX_AGENT_STEPS=25
MAX_PARALLEL_OPPORTUNITIES=8
THINK_INTERVAL=60
GOAL_FILE=goal_state.json
FRIDAY_LEDGER_DB=friday_ledger.sqlite3
LOG_LEVEL=INFO

# AI / reasoning providers (all optional; at least one is needed for LLM work)
# OpenRouter's free router is the zero-budget default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini is OPTIONAL and can remain blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
XAI_API_KEY=
XAI_MODEL=grok-4.1-fast
# OpenAI is OPTIONAL. F.R.I.D.A.Y. will skip it when unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=

# Content/design integration (optional; not an LLM dependency)
GAMMA_API_KEY=

# Payment / invoicing
# Paddle is the primary international payment gateway for v2.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_BASE=https://api.paddle.com
PADDLE_ENV=production
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_SIGNING_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Research / communication / commerce integrations
OPENWEATHER_API_KEY=
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
DEFAULT_RECIPIENT=
ALLOW_AUTONOMOUS_EMAIL=false
MAX_AUTONOMOUS_EMAILS_PER_DAY=20
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# Infrastructure for production Railway deployment
DATABASE_URL=
REDIS_URL=

# Blockchain / market data
COINBASE_RPC_URL=
INFURA_URL=
POLYGON_RPC=
BSC_RPC=
EXCHANGE_NAME=
API_KEY=
API_SECRET=
SYMBOL=BTC/USDT
TIMEFRAME=5m

# Wallet operations are deliberately NOT part of the autonomous goal loop.
WALLET_ADDRESS=
PRIVATE_KEY=
META_MASK_WALLET=

# Routing / reliability
AI_PROVIDER_ORDER=openrouter,groq,gemini,nvidia,xai,openai
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=45
