# F.R.I.D.A.Y. v2 environment template
# NEVER commit real credentials. Put secrets in Railway Variables / GitHub Secrets.

APP_ENV=production
LIVE_MODE=false
PAYMENT_VERIFICATION_REQUIRED=true
MAX_AGENT_STEPS=25
MAX_PARALLEL_OPPORTUNITIES=8
THINK_INTERVAL=60
GOAL_FILE=goal_state.json
FRIDAY_LEDGER_DB=friday_ledger.sqlite3
LOG_LEVEL=INFO

# AI / reasoning providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
XAI_API_KEY=
XAI_MODEL=grok-4.6
NVIDIA_API_KEY=
NVIDIA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GAMMA_API_KEY=

# Research / communication / commerce integrations
OPENWEATHER_API_KEY=
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
DEFAULT_RECIPIENT=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# Blockchain / market data
COINBASE_RPC_URL=
INFURA_URL=
POLYGON_RPC=
BSC_RPC=
EXCHANGE_NAME=
API_KEY=
API_SECRET=
SYMBOL=BTC/USDT
TIMEFRAME=5m

# Wallet operations are deliberately not part of the general goal loop.
WALLET_ADDRESS=
PRIVATE_KEY=
META_MASK_WALLET=

# Routing / reliability
AI_PROVIDER_ORDER=groq,openrouter,openai,xai,nvidia,gemini
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=30
