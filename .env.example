# F.R.I.D.A.Y. environment template
# NEVER commit real credentials. Put secrets in Railway Variables / GitHub Secrets.

# Runtime
APP_ENV=production
LIVE_MODE=false
THINK_INTERVAL=60
GOAL_FILE=goal_state.json
LOG_LEVEL=INFO

# Primary / fallback AI providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
XAI_API_KEY=
XAI_MODEL=grok-4.6
NVIDIA_API_KEY=
NVIDIA_MODEL=
GEMINI_API_KEY=

# Optional content / presentation provider
GAMMA_API_KEY=

# Web / research
OPENWEATHER_API_KEY=

# Email
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
DEFAULT_RECIPIENT=

# Existing commerce integrations (enable only when actually configured)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# Existing market / blockchain data
COINBASE_RPC_URL=
INFURA_URL=
POLYGON_RPC=
BSC_RPC=

# Existing exchange integration (only if applicable)
EXCHANGE_NAME=
API_KEY=
API_SECRET=
SYMBOL=BTC/USDT
TIMEFRAME=5m

# Wallet operations: keep disabled by default.
# Use a dedicated operational wallet, not a personal wallet.
WALLET_ADDRESS=
PRIVATE_KEY=
META_MASK_WALLET=

# Provider routing controls
AI_PROVIDER_ORDER=groq,openrouter,openai,xai,nvidia,gemini
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=30

# Financial verification controls
REVENUE_LEDGER_PATH=data/revenue_ledger.jsonl
PAYMENT_VERIFICATION_REQUIRED=true
