# F.R.I.D.A.Y. environment template
# NEVER commit real credentials. Put secrets in Railway Variables.

APP_ENV=production
FRIDAY_ENGINE_VERSION=3-video-strategy-enhanced
AUTOPILOT_ENABLED=true
AUTOPILOT_INTERVAL_SECONDS=180
COMMERCIAL_EXECUTION_ENABLED=true
COMMERCIAL_TASK_REEXECUTE_SECONDS=3600
