# Provider selection (priority order: explicit > detected keys)
AI_PROVIDER=groq

# Groq (fast open models)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# NVIDIA NIM (local or cloud inference)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-405b-instruct

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenRouter (fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
